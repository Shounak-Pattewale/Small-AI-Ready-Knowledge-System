# Ollama Cloud configuration for LLMKnowledgeService (src/knowledge_system/llm.py).
# Copy to .env and fill in real values for local development. app.py automatically
# loads this file at startup (python-dotenv, load_dotenv(override=False)) - real
# environment variables already set by your shell, Docker Compose, or the VPS always
# take precedence and are never overridden by this file.

# Required. No default - the application refuses to start LLM mode without it.
OLLAMA_API_KEY=

# Optional. Ollama Cloud model identifier.
OLLAMA_MODEL=gemma4

# Optional. Direct Ollama Cloud API base URL (no local daemon required).
OLLAMA_BASE_URL=https://ollama.com

# Optional. Per-request timeout in seconds.
OLLAMA_TIMEOUT_SECONDS=30
